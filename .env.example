# Copy this to .env.local for local development with vercel dev

# Neon (Vercel Postgres) connection string
DATABASE_URL=postgres://...

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# Admin credentials (plain text — stored securely as Vercel env vars, never in git)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here
